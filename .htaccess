RewriteEngine On

# Bloquea archivos ocultos y de configuración (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Forzar WWW para evitar problemas de CORS
RewriteCond %{HTTP_HOST} ^transdorado\.co [NC]
RewriteRule ^(.*)$ https://www.transdorado.co/cotizador_viajes/$1 [R=301,L]

# CORS: lo resuelve la aplicación con una lista de orígenes permitidos (Home::origenes_permitidos)

# Reescritura de URL para CodeIgniter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]