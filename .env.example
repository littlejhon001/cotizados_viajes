# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cotizaciones@transdorado.co
SMTP_FROM_NAME=Cotizador Transdorado

# Firma de las cotizaciones (el nombre no se guarda en el código)
FIRMA_NOMBRE=
FIRMA_CARGO=Gerente General

# Datos de pago para las cláusulas E y G del PDF (datos financieros: solo en .env)
PAGO_MEDIOS=
PAGO_CUENTA_EMPRESA=

# Orígenes extra que pueden llamar al cotizador (separados por coma). transdorado.co y www.transdorado.co ya están permitidos
ALLOWED_ORIGINS=
